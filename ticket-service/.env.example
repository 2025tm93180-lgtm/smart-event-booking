# Run python3 scripts/setup_env.py to generate .env with random local secrets.
MYSQL_ROOT_PASSWORD=replace-with-a-local-root-password
DB_PASSWORD=replace-with-a-local-service-password
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=smart-event-booking
JWT_AUDIENCE=ticket-api
MOCK_NOTIFICATION_FAIL=false

# Real SMTP email: use the relay and sender approved by your mail provider/IT.
# Keep mode=mock until the remaining fields are configured.
NOTIFICATION_MODE=mock
MAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_STARTTLS_REQUIRED=true
SMTP_SSL_ENABLED=false
